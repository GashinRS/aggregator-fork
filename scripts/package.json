{
  "name": "aggregator-client-test",
  "version": "1.0.0",
  "description": "Client test scripts for the aggregator",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "register-user": "tsc && node dist/aggregator/register-user.js",
    "create-service": "tsc && node dist/aggregator/create-service.js",
    "create-service-test": "tsc && node dist/aggregator/create-service-test.js",
    "create-service-patient": "tsc && node dist/aggregator/create-service-patient.js",
    "create-service-patient2": "tsc && node dist/aggregator/create-service-patient2.js",
    "create-patient-slices": "tsc && node dist/aggregator/create-patient-slices.js",
    "register-kvasir-uma-clients": "tsc && node dist/aggregator/register-kvasir-uma-clients.js",
    "create-services-patient-metrics": "tsc && node dist/aggregator/create-services-patient-metrics.js",
    "setup-uma-policies": "tsc && node dist/aggregator/setup-uma-policies.js",
    "convert-sparql": "tsc && node dist/aggregator/convert-sparql.js",
    "get-service": "tsc && node dist/aggregator/get-service.js",
    "poll-service": "tsc && node dist/aggregator/poll-service.js",
    "direct-subscription": "tsc && node dist/aggregator/direct-subscription.js",
    "get-config": "tsc && node dist/aggregator/get-config.js",
    "get-credentials": "tsc && node dist/kvasir/get-credentials.js",
    "pacsoi-setup": "tsc && node dist/kvasir/pacsoi-setup.js",
    "query-pod": "tsc && node dist/kvasir/query-pod.js"
  },
  "dependencies": {
    "@incremunica/query-sparql-incremental": "^2.3.3",
    "@incremunica/user-tools": "^2.3.0",
    "@inrupt/solid-client-authn-core": "^3.1.0",
    "eventsource-parser": "^3.0.6",
    "n3": "^1.26.0",
    "rdf-data-factory": "^2.0.2"
  },
  "devDependencies": {
    "@types/n3": "^1.26.1",
    "@types/node": "^20.19.39",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@comunica-graphql/sparql2graphql-converter": "github:GashinRS/sparql2graphql-converter-fork#main"
  },
  "keywords": [
    "aggregator",
    "client",
    "test"
  ],
